<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Contact SMS Wizard Form View -->
        <record id="view_sms_contact_wizard_form" model="ir.ui.view">
            <field name="name">royce.sms.contact.wizard.form</field>
            <field name="model">royce.sms.contact.wizard</field>
            <field name="arch" type="xml">
                <form string="Send SMS to Contacts">
                    <sheet>
                        <div class="oe_title">
                            <h1>Send SMS to Contacts</h1>
                        </div>
                        
                        <!-- Step 1: Selection -->
                        <group string="Step 1: Select Recipients" name="selection">
                            <field name="selection_type" widget="radio"/>
                            <field name="contact_ids" 
                                   widget="many2many_tags" 
                                   invisible="selection_type != 'selected'" 
                                   required="selection_type == 'selected'"
                                   placeholder="Search contacts..."/>
                        </group>

                        <!-- Statistics Summary -->
                        <group string="Recipients Summary" name="statistics">
                            <field name="total_contacts" readonly="1" label="Total Contacts"/>
                            <field name="contacts_with_phone" readonly="1" label="With Phone Numbers"/>
                        </group>

                        <!-- Step 2: Message -->
                        <group string="Step 2: Compose Message" name="message">
                            <field name="template_id" 
                                   nolabel="1"
                                   placeholder="Select a template..."/>
                            <field name="custom_message" 
                                   widget="textarea"
                                   invisible="template_id != False"
                                   placeholder="Or enter your custom message here..."
                                   nolabel="1"/>
                        </group>

                        <!-- Step 3: Preview -->
                        <group string="Step 3: Preview" 
                               invisible="not message_preview" 
                               name="preview">
                            <field name="message_preview" 
                                   widget="text" 
                                   readonly="1"
                                   nolabel="1"/>
                        </group>

                        <!-- Info Alert -->
                        <div class="alert alert-info" role="alert">
                            <strong>Note:</strong> Only contacts with valid phone numbers will receive SMS messages.
                        </div>
                    </sheet>
                    <footer>
                        <button name="send_sms" 
                                type="object" 
                                string="Send SMS" 
                                class="btn-primary"/>
                        <button string="Cancel" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Contact SMS Wizard Action -->
        <record id="action_sms_contact_wizard" model="ir.actions.act_window">
            <field name="name">Send SMS to Contacts</field>
            <field name="res_model">royce.sms.contact.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>